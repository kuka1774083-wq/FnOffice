#!/bin/sh

# Remove only Docker resources owned by FnOffice. Host bind-mounted data is
# deliberately preserved so uninstall does not delete documents or settings.
log_file="${TRIM_TEMP_LOGFILE:-/tmp/fnoffice-uninstall.log}"
{
  echo "FnOffice Docker cleanup started: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if command -v docker >/dev/null 2>&1; then
    for name in fnoffice-onlyoffice fnoffice-callback-relay; do
      if docker rm -f "$name" >/dev/null 2>&1; then
        echo "removed container=$name"
      fi
    done
    legacy_ids="$(docker ps -aq --filter label=com.docker.compose.project=fnoffice-onlyoffice 2>/dev/null || true)"
    if [ -n "$legacy_ids" ]; then
      docker rm -f $legacy_ids >/dev/null 2>&1 || true
      echo "removed legacy Compose containers"
    fi
    if docker network rm fnoffice-internal >/dev/null 2>&1; then
      echo "removed network=fnoffice-internal"
    fi
  else
    echo "docker command not found; no Docker resources changed"
  fi
  echo "FnOffice Docker cleanup finished: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
} >> "$log_file" 2>&1 || true
exit 0
