#!/bin/sh
set -eu
# Keep both font lists outside the target while fnOS replaces package files.
app_dest="${TRIM_APPDEST:-/var/apps/FnOffice/target}"
app_volume="$(dirname "$(dirname "$app_dest")")"
var_dir="${TRIM_PKGVAR:-$app_volume/@appdata/FnOffice}"
backup="$var_dir/.font-upgrade-backup"
mkdir -p "$backup" 2>/dev/null || exit 0
for pair in "fonts:enabled" "fonts-disabled:disabled"; do
  src_name="${pair%%:*}"; dst_name="${pair##*:}"
  for src in "$var_dir/$src_name" "$app_dest/app/docker/onlyoffice/$src_name" "$app_dest/docker/onlyoffice/$src_name"; do
    if [ -d "$src" ]; then
      # Merge into the backup instead of skipping when a previous interrupted
      # upgrade left a partial backup behind.
      mkdir -p "$backup/$dst_name" 2>/dev/null || true
      cp -a "$src/." "$backup/$dst_name/" 2>/dev/null || true
      rm -rf "$src" 2>/dev/null || true
      break
    fi
  done
done
exit 0
